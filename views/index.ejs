<body>
  <main>
    <div class="container">

      <!-- Left -->
      <section class="flex-left y-scrollable auto-padding">
        <h1>
          kevin n. chen is a <span class="color-design">designer</span> and <span class="color-programming">programmer</span>
          based in new york from maryland
        </h1>
        <p>
          they are interested in tool-making, infrastructure, visibility, gardening, gathering,
          hosting, archiving, printing, websites, engines, systems, performance, and open source
        </p>
        <p>
          they tend a garden at <a class="color-design" href="https://kevin.garden">kevin.garden</a>, where they arrange files,
          plot directories, and sometimes grow vegetables and herbs
        </p>
        <p>
          (links)
          <a href="mailto:k@kevinnchen.com">email</a>,
          <a href="https://www.are.na/kevin" target="_blank">are.na</a>,
          <a href="https://twitter.com/inchkev" target="_blank">twitter</a>,
          <a href="https://www.instagram.com/inchkev/" target="_blank">instagram</a>,
          <a href="https://github.com/inchkev" target="_blank">github</a>
        </p>

        <div id="projects">
          <ol>
            <%_ projects.forEach(function(project) { _%>
            <li class="el color-<%= project.type %>" data-project="<%= project.slug %>">
              <%_ if (project.externalLink) { _%>
              <a href="<%= project.externalLink %>">
              <%_ } else { _%>
              <a href="projects/<%= project.slug %>">
              <%_ } _%>
                <p class="title"><%= project.title %></p>
                <p class="date"><%= project.date %></p>
              </a>
            </li>
            <%_ }); _%>
          </ol>
        </div>

        <p>
          filter by <button name="design" class="color-design">design</button>,
          <button name="programming" class="color-programming">programming</button>,
          <button name="other" class="color-other">misc</button>
        </p>
      </section>

      <!-- Right -->
      <section class="flex-right y-scrollable auto-padding">
        <div id="image-grid">
          <%_ projects.forEach(function(project) { _%>
          <div class="box color-<%= project.type %>" data-project="<%= project.slug %>">
            <%_ if (project.externalLink) { _%>
            <a href="<%= project.externalLink %>" aria-label="Visit project link: <%= project.title %>">
            <%_ } else { _%>
            <a href="projects/<%= project.slug %>" aria-label="Visit project: <%= project.title %>">
            <%_ } _%>
              <%_ if (project.thumbnail.type === "image") { _%>
              <img src="<%= project.thumbnail.src %>" width="<%= project.thumbnail.width %>" height="<%= project.thumbnail.height %>" alt="<%= project.thumbnail.alt %>">
              <%_ } else if (project.thumbnail.type === "video") { _%>
              <video width="<%= project.thumbnail.width %>" height="<%= project.thumbnail.height %>" muted autoplay loop playsinline>
                <source src="<%= project.thumbnail.src.webm %>" type="video/webm">
                <source src="<%= project.thumbnail.src.mp4 %>" type="video/mp4">
              </video>
              <%_ } _%>
            </a>
          </div>
          <%_ }); _%>
        </div>
      </section>

    </div>
  </main>

  <footer>
    <p>(see also)</p>
    <p><a href="https://p.kevin.garden">weblog</a></p>
    <p><a href="https://file.gallery">file.gallery</a></p>
    <p><a href="https://font.fish">font.fish</a></p>
  </footer>

  <script src="/js/index.min.js"></script>
  <!-- the un-minified version can be found at "/js/index.js" -->
  <!-- (or visit the github source) -->
</body>
</html>
